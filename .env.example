# =============================================================================
# Project Knox — Environment Variables Example
# Copy this file to .env (for apps/api) or .env.local (for apps/web)
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/project_knox"
# For Supabase, use the pooled connection string for runtime:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL is used by Prisma Migrate (non-pooled):
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# =============================================================================
# AUTHENTICATION (NextAuth.js v5 / Auth.js)
# =============================================================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# JWT secret for mobile API auth
JWT_SECRET="generate-with-openssl-rand-base64-32"

# =============================================================================
# EXTERNAL APIs — FEDERAL LEGISLATION
# =============================================================================
# Congress.gov API (free) — register at https://api.congress.gov/sign-up/
CONGRESS_API_KEY=""

# =============================================================================
# EXTERNAL APIs — STATE LEGISLATION
# =============================================================================
# OpenStates API (free) — register at https://open.pluralpolicy.com/
OPENSTATES_API_KEY=""

# =============================================================================
# EXTERNAL APIs — REPRESENTATIVE LOOKUP
# =============================================================================
# US Census Bureau Geocoding API — no key required (free)
# https://geocoding.geo.census.gov/geocoder/

# LegiScan API (free tier: 30k req/month) — register at https://legiscan.com/legiscan
# Covers both federal AND state bills in one API
LEGISCAN_API_KEY=""

# OPTIONAL: Cicero API (paid, best for local rep lookup) — https://www.cicerodata.com/
# Free trial: 1,000 credits. ~$298/yr for nonprofits.
CICERO_API_KEY=""

# =============================================================================
# EXTERNAL APIs — CONTACT / EMAIL
# =============================================================================
# Resend (transactional email) — register at https://resend.com/
# Free tier: 3,000 emails/month
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@yourdomain.com"

# =============================================================================
# CACHING
# =============================================================================
# Upstash Redis (serverless Redis) — https://upstash.com/
# Free tier: 10,000 commands/day
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# For local development with a local Redis instance:
# REDIS_URL="redis://localhost:6379"

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Secret to verify Vercel Cron job requests
CRON_SECRET="generate-a-random-secret"

# Node environment
NODE_ENV="development"
